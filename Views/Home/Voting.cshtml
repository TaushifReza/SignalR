<div class="container py-4">
    <div class="card shadow border-0">
        <div class="card-header bg-dark text-white p-3">
            <h3 class="mb-0 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-triangle me-2" viewBox="0 0 16 16">
                    <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.146.146 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.163.163 0 0 1-.054.06.116.116 0 0 1-.066.017H1.146a.115.115 0 0 1-.066-.017.163.163 0 0 1-.054-.06.176.176 0 0 1 .002-.183L7.884 2.073a.147.147 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566z" />
                    <path d="M8 5.5a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5z" />
                    <path d="M7.25 5a.75.75 0 1 1 1.5 0 .75.75 0 0 1-1.5 0z" />
                </svg>
                Deathly Hallows Race
            </h3>
        </div>

        <div class="card-body">
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-0 shadow-sm hallows-card">
                        <div class="card-body text-center">
                            <div class="hallows-icon mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-circle text-primary" viewBox="0 0 16 16">
                                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                                </svg>
                            </div>
                            <h5 class="card-title">Invisibility Cloak</h5>
                            <div class="counter-display my-3">
                                <span id="cloakCounter" class="display-6 fw-bold text-primary">0</span>
                                <span class="text-muted">votes</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-primary" role="progressbar" id="cloakProgress" style="width: 0%"></div>
                            </div>
                            <a href="/Home/DeathlyHallows?type=cloak" class="btn btn-outline-primary mt-3 vote-btn">Vote</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-0 shadow-sm hallows-card">
                        <div class="card-body text-center">
                            <div class="hallows-icon mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-circle-fill text-secondary" viewBox="0 0 16 16">
                                    <circle cx="8" cy="8" r="8" />
                                </svg>
                            </div>
                            <h5 class="card-title">Resurrection Stone</h5>
                            <div class="counter-display my-3">
                                <span id="stoneCounter" class="display-6 fw-bold text-secondary">0</span>
                                <span class="text-muted">votes</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-secondary" role="progressbar" id="stoneProgress" style="width: 0%"></div>
                            </div>
                            <a href="/Home/DeathlyHallows?type=stone" class="btn btn-outline-secondary mt-3 vote-btn">Vote</a>
                        </div>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="card h-100 border-0 shadow-sm hallows-card">
                        <div class="card-body text-center">
                            <div class="hallows-icon mb-3">
                                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="currentColor" class="bi bi-lightning-fill text-warning" viewBox="0 0 16 16">
                                    <path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z" />
                                </svg>
                            </div>
                            <h5 class="card-title">Elder Wand</h5>
                            <div class="counter-display my-3">
                                <span id="wandCounter" class="display-6 fw-bold text-warning">0</span>
                                <span class="text-muted">votes</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar bg-warning" role="progressbar" id="wandProgress" style="width: 0%"></div>
                            </div>
                            <a href="/Home/DeathlyHallows?type=wand" class="btn btn-outline-warning mt-3 vote-btn">Vote</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card border-0 bg-light">
                <div class="card-body">
                    <h5 class="card-title">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-share" viewBox="0 0 16 16">
                            <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5zm-8.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zm11 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z" />
                        </svg>
                        Share Voting Links
                    </h5>
                    <div class="list-group mt-3">
                        <div class="list-group-item list-group-item-action d-flex align-items-center">
                            <span class="badge bg-primary rounded-pill me-2">1</span>
                            <div class="ms-1">
                                <div>Invisibility Cloak</div>
                                <code class="small text-muted">https://localhost:7155/Home/DeathlyHallows?type=cloak</code>
                            </div>
                            <button class="btn btn-outline-primary btn-sm ms-auto copy-btn" data-clipboard="https://localhost:7155/Home/DeathlyHallows?type=cloak">
                                Copy
                            </button>
                        </div>

                        <div class="list-group-item list-group-item-action d-flex align-items-center">
                            <span class="badge bg-secondary rounded-pill me-2">2</span>
                            <div class="ms-1">
                                <div>Resurrection Stone</div>
                                <code class="small text-muted">https://localhost:7155/Home/DeathlyHallows?type=stone</code>
                            </div>
                            <button class="btn btn-outline-secondary btn-sm ms-auto copy-btn" data-clipboard="https://localhost:7155/Home/DeathlyHallows?type=stone">
                                Copy
                            </button>
                        </div>

                        <div class="list-group-item list-group-item-action d-flex align-items-center">
                            <span class="badge bg-warning rounded-pill me-2">3</span>
                            <div class="ms-1">
                                <div>Elder Wand</div>
                                <code class="small text-muted">https://localhost:7155/Home/DeathlyHallows?type=wand</code>
                            </div>
                            <button class="btn btn-outline-warning btn-sm ms-auto copy-btn" data-clipboard="https://localhost:7155/Home/DeathlyHallows?type=wand">
                                Copy
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="alert alert-info mt-4 d-flex align-items-center" role="alert">
                <div class="d-flex align-items-center me-2">
                    <div class="spinner-grow spinner-grow-sm me-2" role="status" id="connectionIndicator"></div>
                    <span id="connectionStatus">Connected</span>
                </div>
                <div class="ms-auto">
                    <span id="lastUpdate" class="small text-muted">Last updated: Just now</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/signalr.js"></script>
<script src="~/js/dealthyHallows.js"></script>